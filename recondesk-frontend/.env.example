# Supabase — get these from https://supabase.com/dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Site origin for email redirects (magic link, signup confirm, password reset).
# In Supabase Dashboard → Authentication → URL Configuration, set:
#   Site URL: http://localhost:3000
#   Redirect URLs: http://localhost:3000/auth/callback
# Emails should link to /auth/callback (not /) so exchangeCodeForSession runs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# FastAPI backend on Railway
NEXT_PUBLIC_API_URL=https://your-service.up.railway.app
