{
  "id": "rule37_multi_period_and_thin_rerun",
  "bug_class": "latest_run_sparse_join_silent_drop",
  "module": "rule37_alert_scan",
  "description": "Alert scan must cover every tax period's PR-bearing completed run. A newer May run must not hide April, and a thin same-period re-run with no pr_records must fall back to the older PR-bearing run.",
  "input": {
    "runs": [
      {
        "id": "may-full",
        "period": "2025-05",
        "created_at": "2025-06-10T00:00:00Z"
      },
      {
        "id": "apr-thin",
        "period": "2025-04",
        "created_at": "2025-05-20T00:00:00Z"
      },
      {
        "id": "apr-full",
        "period": "2025-04",
        "created_at": "2025-05-01T00:00:00Z"
      }
    ],
    "pr_nonempty_run_ids": ["may-full", "apr-full"]
  },
  "expect": {
    "selected_run_ids_set": ["may-full", "apr-full"],
    "selected_run_ids_order": ["may-full", "apr-full"],
    "must_not_select": ["apr-thin"]
  }
}
