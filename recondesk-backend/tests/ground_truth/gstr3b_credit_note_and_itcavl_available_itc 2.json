{
  "id": "gstr3b_credit_note_and_itcavl_available_itc",
  "bug_class": "available_itc_silent_inflation",
  "module": "gstr3b_available_itc",
  "description": "Available ITC summed all 2B line taxes with positive signs. Credit notes inflated available ITC and itcavl=N invoices were included — both can mask a real DRC-01C overclaim by making claimed−available look smaller.",
  "input": {
    "records": [
      {
        "doc_type": "INVOICE",
        "itc_available": true,
        "items": [
          { "igst_paise": 100000000, "cgst_paise": 0, "sgst_paise": 0 }
        ]
      },
      {
        "doc_type": "CREDIT_NOTE",
        "itc_available": true,
        "items": [
          { "igst_paise": 50000000, "cgst_paise": 0, "sgst_paise": 0 }
        ]
      },
      {
        "doc_type": "INVOICE",
        "itc_available": false,
        "items": [
          { "igst_paise": 99900000, "cgst_paise": 0, "sgst_paise": 0 }
        ]
      }
    ],
    "claimed_total": 4000000.0
  },
  "expect": {
    "available_igst": 500000.0,
    "available_total": 500000.0,
    "triggers_drc01c": true,
    "wrong_available_if_cn_positive_and_itcavl_included": 2499000.0,
    "wrong_would_trigger_drc01c": false
  }
}
