# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_VERSION=1.0
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_ORIGINS=http://localhost:3000,https://app.recondesk.com

# ── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Postgres connection string (for Alembic migrations). Use "Session mode" URI from Supabase → Settings → Database.
# Example: postgresql://postgres.[PROJECT]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
DATABASE_URL=

# ── Cloudflare R2 ─────────────────────────────────────────────────────────────
R2_ACCOUNT_ID=<cloudflare-account-id>
R2_ACCESS_KEY_ID=<r2-access-key>
R2_SECRET_ACCESS_KEY=<r2-secret-key>
R2_BUCKET_NAME=recondesk-uploads
R2_PUBLIC_URL=https://pub-<hash>.r2.dev

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Razorpay ──────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=<rzp-key-id>
RAZORPAY_KEY_SECRET=<rzp-key-secret>

# ── Amazon SES (SMTP) ────────────────────────────────────────────────────────
SES_SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SES_SMTP_PORT=587
SES_SMTP_USER=<your-ses-smtp-username>
SES_SMTP_PASS=<your-ses-smtp-password>
EMAIL_FROM=ReconDesk <noreply@recondesk.in>

# ── Resend (Legacy / Fallback Email) ──────────────────────────────────────────
# RESEND_API_KEY=re_<api-key>

# ── Sentry ────────────────────────────────────────────────────────────────────
SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>

# ── Import pipeline (Celery + Redis) ───────────────────────────────────────────
# Optional: R2 S3 API URL. If unset, https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com is used.
# R2_ENDPOINT_URL=

REDIS_URL=redis://localhost:6379/0
# false = run imports in the API process (no worker). true = queue to Celery; run: ./scripts/run_celery_worker.sh
# Production (APP_ENV=production) always queues imports even if this is false — keep a Celery worker running.
IMPORT_USE_CELERY=false
# false = record sanity issues in sanity_report but still insert rows (typical for GSTR-2B). true = fail the run on any error-level sanity check.
IMPORT_SANITY_STRICT=false

# ── Sandbox.co.in GST API ─────────────────────────────────────────────────────
# Required for automatic IMS status fetch and GSTR-2B pull (instead of manual upload).
# Also required for GSTIN public verification (POST /api/gstin/verify).
# Get your key from: https://accounts.sandbox.co.in → Settings → API Keys
SANDBOX_API_KEY=<your-sandbox-api-key>
# Required for GSTIN public verification (/authenticate call).
SANDBOX_API_SECRET=<your-sandbox-api-secret>
# Optional: JWT access token from the Sandbox /authenticate endpoint (required for taxpayer-level endpoints)
# SANDBOX_ACCESS_TOKEN=<jwt-token>
# Optional overrides — leave blank to use defaults
# SANDBOX_BASE_URL=https://api.sandbox.co.in
# SANDBOX_API_VERSION=1.0.0

# ── GSTR-3B filing gate ───────────────────────────────────────────────────────
# Offset moves real GST ledger money. Unset → on in local/dev, off in production.
# Set true only after Save → Offset → File is live-proven end-to-end.
# GSTR3B_FILING_ENABLED=true
