# ==============================================================================
# ReconDesk Staging Environment Configuration (.env.staging.example)
#
# STRICT ISOLATION NOTICE:
# This file defines non-production placeholders for local staging verification.
# StagingGuard enforces fail-closed execution if any production host, key,
# bucket, or user pool is detected.
# ==============================================================================

# ── Application Environment ───────────────────────────────────────────────────
APP_ENV=staging
APP_VERSION=1.0.1
SECRET_KEY=staging-synthetic-secret-key-32b-minimum-passphrase!
DATA_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef
JWT_SECRET=staging-jwt-synthetic-secret-key-32b-passphrase!
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8001
FRONTEND_URL=http://localhost:3000

# ── Isolated Staging Database (PostgreSQL 16) ─────────────────────────────────
# Connected via staging-net internal docker network (port 5432) or host port 5433
DATABASE_URL=postgresql://postgres:postgres@staging-db:5432/recondesk_staging
AURORA_DATABASE_URL=postgresql+psycopg2://postgres:postgres@staging-db:5432/recondesk_staging
AURORA_DB_ENABLED=true
AURORA_SSL_MODE=disable
AURORA_POOL_SIZE=5
AURORA_MAX_OVERFLOW=2
AURORA_CONNECT_TIMEOUT_SECONDS=10

# ── Isolated Staging Cache & Broker (Redis 7) ─────────────────────────────────
# Connected via staging-net internal docker network (port 6379) or host port 6380
REDIS_URL=redis://staging-redis:6379/0
IMPORT_USE_CELERY=true
JOB_HEARTBEAT_TIMEOUT_SECONDS=300

# ── Authentication & Tenancy (Amazon Cognito Mock/Staging) ─────────────────────
COGNITO_AUTH_ENABLED=false
COGNITO_REGION=ap-south-1
COGNITO_USER_POOL_ID=ap-south-1_STAGING001
COGNITO_CLIENT_ID=staging_client_id_001
COGNITO_CLIENT_SECRET=staging_client_secret_placeholder
COGNITO_REDIRECT_URI=http://localhost:3000/api/auth/cognito/callback

# ── Storage (Isolated Staging Bucket / Mock Object Storage) ────────────────────
R2_ENDPOINT_URL=http://staging-mock:9000
R2_ACCOUNT_ID=staging_mock_account
R2_BUCKET_NAME=recondesk-staging-uploads
R2_ACCESS_KEY_ID=staging_mock_access_key
R2_SECRET_ACCESS_KEY=staging_mock_secret_key
R2_PUBLIC_URL=http://staging-mock:9000/recondesk-staging-uploads

# ── Billing & Payments (Razorpay Sandbox/Test Mode) ───────────────────────────
RAZORPAY_KEY_ID=rzp_test_staging0000000000
RAZORPAY_KEY_SECRET=staging_test_razorpay_secret_placeholder

# ── Outbound Notifications (Mock SMTP / Blackhole) ────────────────────────────
SES_SMTP_HOST=staging-mock
SES_SMTP_PORT=587
SES_SMTP_USER=
SES_SMTP_PASS=
EMAIL_FROM=ReconDesk Staging <noreply@staging.recondesk.in>

# ── GSTN Sandbox & Filing Safeguards ──────────────────────────────────────────
# GSTR-3B ledger offset and filing MUST remain False in staging
GSTR3B_FILING_ENABLED=false
SANDBOX_API_KEY=mock_staging_sandbox_key
SANDBOX_API_SECRET=mock_staging_sandbox_secret
SANDBOX_BASE_URL=http://staging-mock:9000
SANDBOX_API_VERSION=1.0.0
